<%layout('/layouts/boilerplate.ejs')%>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <br><br>
    <h3>YOU ARE CREATING A NEW LISTING...</h3>
    <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
        <div class="mb-3">
        <lable for="title" class="form-label">Title</lable>
        <input name="listing[title]" placeholder="ADD  A  CATHCY  TITILE" type="text" class="form-control" required>
        <div class="valid-feedback">Tiltle looks good!</div>
        <div class="invalid-feedback">Please enter correct title!</div>
        </div>
        <div class="mb-3">
        <lable for="description" class="form-label">Description</lable>    
        <textarea name="listing[description]"  type="text" class="form-control" required></textarea> 
        <div class="invalid-feedback">Please enter description!</div>
       
        </div>


      <!--for upload file..-->
        <div class="mb-3">
        <lable for="image" class="form-label">Upload Listing Image</lable>
        <input name="listing[image]"   type="file" class="form-control" required>
        <div class="invalid-feedback">Please enter correct URL!</div>
        <div class="valid-feedback">URL looks correct!</div>
        </div>



        <div class="row">
        <div class="mb-3 col-md-4">
        <lable for="price" class="form-label">Price</lable>
         <input name="listing[price]" placeholder="ADD  PRICE"  class="form-control" required>
         <div class="invalid-feedback">Please enter correct price!</div>
        </div >
        </div>
         <div class="mb-3 col-md-8" >
        <lable for="country" class="form-label">Country</lable>
        <input name="listing[country]" placeholder="ENTER  COUNTRY"  class="form-control" required>
         <div class="invalid-feedback">Please enter correct country name!</div>
        </div>
         <div class="mb-3">
        <lable for="location" class="form-label">Location</lable>
        <input name="listing[location]" placeholder="ENTER  LOCATION"  class="form-control" required>
        <div class="invalid-feedback">Please enter correct location!</div>
         </div>
        <div class="mb-3">
  <label for="category" class="form-label">Category</label>
  <select name="listing[category]" id="category" class="form-select" required>
    <option value="" disabled selected>Choose a category</option>
    <% const cats = ["Trending","Rooms","Iconic cities","Mountains","Castles","Amazing Pools","Camping","Farms","Arctic","Domes","Boats"]; %>
    <% for (let c of cats) { %>
      <option value="<%= c %>"><%= c %></option>
    <% } %>
  </select>
</div>
        
        <button class="btn btn-dark add-btn mt-3">SAVE DATA</button>
    <br><br>
    </form>
   </div> 
   </div>
    

